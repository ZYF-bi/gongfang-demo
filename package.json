{
  "name": "xiaoyan-workshop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests *.ts *.json *.yaml README.md",
    "format:check": "prettier --check src tests *.ts *.json *.yaml README.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
