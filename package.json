    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "parse5": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
